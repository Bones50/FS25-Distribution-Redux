<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="distributionMarketsPage">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_prices"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_dr_title_markets"/>
        </GuiElement>

        <!-- left: market list -->
        <Bitmap profile="SDList" position="0px -46px" size="370px 40px">
            <Text profile="SDHeaderLeft" position="16px 0px" size="340px 40px" text="$l10n_dr_col_markets" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>
        <SmoothList profile="SDList" id="assetList" position="0px -90px" size="370px 720px"
                    onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
            <ListItem profile="SDListItem" name="rowTemplate" size="370px 52px" onClick="onClickAsset">
                <Bitmap position="10px 6px" size="48px 40px" name="assetIcon" imageColor="1 1 1 1" />
                <!-- renamed buildings: player's name on top, original store name beneath (positive Y = up) -->
                <Text profile="SDRowCell" position="66px 10px"  size="180px 26px" textSize="17px" name="assetName" />
                <Text profile="SDRowCell" position="66px -12px" size="180px 20px" textSize="13px" name="assetOrigName" />
                <Text profile="SDRowCell" position="252px 0px" size="106px 52px" textSize="15px" name="assetType" />
            </ListItem>
        </SmoothList>

        <!-- timescale for every figure on this page, plus a pointer to the Overview tab, which carries the
             per-product breakdown these columns deliberately no longer repeat -->
        <Bitmap profile="SDList" position="390px -46px" size="1090px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="110px 40px" textSize="18px" text="$l10n_dr_lbl_timescale"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="130px 0px" size="380px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="periodOption" onClick="onPeriodChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
            <Text profile="SDHeaderLeft" position="530px 0px" size="550px 40px" textSize="14px"
                  id="marketsHint" text="$l10n_dr_lbl_overviewPointer" />
        </Bitmap>

        <!-- right: INCOMING PRODUCTS (what the market receives). Animal Husbandry column set;
             rows selectable, ready for the input drill-down. -->
        <Bitmap profile="SDList" position="390px -92px" size="1090px 40px">
            <Text profile="SDHeaderLeft" position="44px 0px"  size="200px 40px" textSize="11px" text="$l10n_dr_col_incomingProducts" />
            <Text profile="SDHeaderLeft" position="252px 0px" size="100px 40px" textSize="11px" text="$l10n_dr_col_storageType" />
            <Text profile="SDHeaderLeft" position="360px 0px" size="240px 40px" textSize="11px" text="$l10n_dr_col_heldSlashMax" />
            <Text profile="SDHeaderLeft" position="608px 0px" size="115px 40px" textSize="11px" text="$l10n_dr_col_freeStorage" />
            <Text profile="SDHeaderLeft" position="731px 0px" size="140px 40px" textSize="11px" text="$l10n_dr_col_received" />
            <Text profile="SDHeaderLeft" position="879px 0px" size="211px 40px" textSize="11px" text="$l10n_dr_col_distribution" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>
        <GuiElement profile="SDList" position="390px -136px" size="1090px 280px">
            <SmoothList profile="SDList" id="inputList" position="0px 0px" size="1090px 280px"
                        onSelectionChanged="onInputSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1090px 42px" onClick="onClickInputRow">
                    <!-- full-width overlay for the "+N blocked" notice row; hidden on every normal row -->
                    <Text profile="SDRowCell" position="44px 0px" size="1030px 42px" textSize="12px" name="noticeText" visible="false" />
                    <Bitmap position="12px 9px" size="24px 24px" name="fillIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell" position="44px 0px"  size="200px 42px" textSize="12px" name="fillName" />
                    <Text profile="SDRowCell" position="252px 0px" size="100px 42px" textSize="12px" name="typeText" />
                    <Text profile="SDRowCell" position="360px 0px" size="240px 42px" textSize="12px" name="heldText" />
                    <Text profile="SDRowCell" position="608px 0px" size="115px 42px" textSize="12px" name="remainingText" />
                    <Text profile="SDRowCell" position="731px 0px" size="140px 42px" textSize="12px" name="recvText" />
                    <Text profile="SDRowCell" position="879px 0px" size="211px 42px" textSize="12px" name="statusText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 280px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 272px" dataElementId="inputList" id="inputSlider" />
            </ThreePartBitmap>
        </GuiElement>

        <!-- OUTGOING PRODUCTS (what the market sells). DISTRIBUTED is everything that left the buffer,
             with the sale value in brackets. A market makes nothing, so there is no PRODUCED column. -->
        <Bitmap profile="SDList" position="390px -426px" size="1090px 40px">
            <Text profile="SDHeaderLeft" position="44px 0px"  size="230px 40px" textSize="11px" text="$l10n_dr_col_outgoingProducts" />
            <Text profile="SDHeaderLeft" position="282px 0px" size="235px 40px" textSize="11px" text="$l10n_dr_col_heldMax" />
            <Text profile="SDHeaderLeft" position="525px 0px" size="115px 40px" textSize="11px" text="$l10n_dr_col_freeStorage" />
            <Text profile="SDHeaderLeft" position="648px 0px" size="150px 40px" textSize="11px" text="$l10n_dr_col_distributed" />
            <Text profile="SDHeaderLeft" position="806px 0px" size="284px 40px" textSize="11px" text="$l10n_dr_col_outputMode" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>

        <GuiElement profile="SDList" position="390px -470px" size="1090px 340px">
            <SmoothList profile="SDList" id="detailList" position="0px 0px" size="1090px 340px"
                        focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1090px 42px" onClick="onClickDetailRow">
                    <!-- full-width overlay for the "+N blocked" notice row; hidden on every normal row -->
                    <Text profile="SDRowCell" position="44px 0px" size="1030px 42px" textSize="12px" name="noticeText" visible="false" />
                    <Bitmap position="12px 9px" size="24px 24px" name="fillIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell" position="44px 0px"  size="230px 42px" textSize="12px" name="fillName" />
                    <Text profile="SDRowCell" position="282px 0px" size="235px 42px" textSize="12px" name="heldText" />
                    <Text profile="SDRowCell" position="525px 0px" size="115px 42px" textSize="12px" name="remainingText" />
                    <Text profile="SDRowCell" position="648px 0px" size="150px 42px" textSize="12px" name="distText" />
                    <!-- In-row timing arrows, the same contract as the other three tabs (5.64): the
                         callback is ONE reference cloned into every row, so populate stashes the fill
                         type on the element and the handler reads it back. They step the market TIMING
                         ring (Hold -> Sell Immediate -> Sell Best price), not the asset mode ring.
                         They fit INSIDE the old modeText band, so no flow column lost width:
                         806 + 30 (prev) + 220 (text) + 34 (next) = 1090, exactly as before. -->
                    <Button profile="fs25_multiTextOptionLeft" position="806px 0px" name="modePrev" onClick="onModePrev" />
                    <Text   profile="SDRowCell" position="836px 0px" size="220px 42px" textSize="12px" name="modeText" />
                    <Button profile="SDRowArrowRight" position="1056px 0px" name="modeNext" onClick="onModeNext" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 340px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 332px" dataElementId="detailList" id="detailSlider" />
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>

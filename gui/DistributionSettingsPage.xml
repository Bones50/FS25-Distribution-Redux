        <!-- THE SCROLLBAR. This page never had one; the list has always relied on the
             wheel. ScrollingLayoutElement keeps a `sliderElement` that a Slider binds to
             through #dataElementId, exactly as the User Guide's sliders bind to their
             SmoothLists.
             THE WRAPPER CARRIES THE LIST'S OWN PROFILE, so it inherits the list's exact
             box and nothing here has to know the container's width. fs25_listSliderBox is
             anchorStretchingYRight at position 21px in its own profile, so it lands just
             outside the list's right edge, inside the margin absoluteSizeOffset leaves. -->
        <GuiElement profile="SDSettingsLayoutTabbed">
            <ThreePartBitmap profile="fs25_listSliderBox" size="6px 100%">
                <Slider profile="fs25_listSlider" dataElementId="boxLayout" id="settingsSlider"/>
            </ThreePartBitmap>
        </GuiElement>


        <!-- EXTENSION SETTING ROWS. Twelve generic slots another mod fills through
             SmartDistribution.API.registerSettingsTab. DR OWNS THE LAYOUT, THE
             PROVIDER OWNS THE DATA, which is the same split registerHusbandryPanel
             already uses: a table of definitions cannot break a page whose geometry
             is hand tiled to the pixel, an element placed by a foreign mod can.
             Unused slots are HIDDEN rather than repositioned, exactly as the tab
             strip above does with PAGE_TAB_MAX (5.37).
             THEY SIT IN THIS SAME ScrollingLayout on purpose, so the one slider
             serves both sets and no second scrollbar has to be declared. Switching
             tab is a per row setVisible plus invalidateLayout: BoxLayoutElement
             getIsElementIncluded excludes an invisible child when ignoreVisibility
             is false, which is what invalidateLayout() defaults to.
             NO onCreate here. onCreateSetting would file these under ids that are
             not DR settings, and the alternating tint is applied at RENDER instead
             so a foreign tab always starts its banding at its own first row rather
             than continuing DR's. -->

            <Bitmap profile="fs25_multiTextOptionContainer" name="drExtRow1" id="drExtRow1" visible="false">
                <MultiTextOption profile="fs25_settingsMultiTextOption" onClick="onExtOptionChanged"
                                 name="drExtOpt1" id="drExtOpt1">
                    <Text profile="fs25_multiTextOptionTooltip" name="drExtTip1" id="drExtTip1" text=""/>
                </MultiTextOption>
                <Text profile="fs25_settingsMultiTextOptionTitle" name="drExtTitle1" id="drExtTitle1" text=""/>
            </Bitmap>


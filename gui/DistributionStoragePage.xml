<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="distributionStoragePage">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_options_gameSettings2"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_dr_title_storage"/>
        </GuiElement>

        <!-- left: building list -->
        <Bitmap profile="SDList" position="0px -46px" size="370px 40px">
            <Text profile="SDHeaderLeft" position="16px 0px" size="340px 40px" text="$l10n_dr_col_buildings" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>
        <SmoothList profile="SDList" id="assetList" position="0px -90px" size="370px 720px"
                    onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
            <ListItem profile="SDListItem" name="rowTemplate" size="370px 52px" onClick="onClickAsset">
                <Bitmap position="10px 6px" size="48px 40px" name="assetIcon" imageColor="1 1 1 1" />
                <!-- renamed buildings: player's name on top, original store name beneath (positive Y = up) -->
                <Text profile="SDRowCell" position="66px 10px"  size="180px 26px" textSize="17px" name="assetName" />
                <Text profile="SDRowCell" position="66px -12px" size="180px 20px" textSize="13px" name="assetOrigName" />
                <Text profile="SDRowCell" position="252px 0px" size="106px 52px" textSize="15px" name="assetType" />
            </ListItem>
        </SmoothList>

        <!-- timescale for every figure on this page, plus a pointer to the Overview tab, which carries the
             per-product breakdown these columns deliberately no longer repeat -->
        <Bitmap profile="SDList" position="390px -46px" size="1090px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="110px 40px" textSize="18px" text="$l10n_dr_lbl_timescale"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="130px 0px" size="380px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="periodOption" onClick="onPeriodChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
            <Text profile="SDHeaderLeft" position="530px 0px" size="550px 40px" textSize="14px"
                  text="$l10n_dr_lbl_overviewPointer" />
        </Bitmap>

        <!-- right: INCOMING PRODUCTS (inputs). Same products the building can hold, with the Animal
             Husbandry column set; rows are selectable, ready for the input drill-down. -->
        <Bitmap profile="SDList" id="inputHeaderRow" position="390px -92px" size="1090px 40px">
            <Text profile="SDHeaderLeft" position="44px 0px"  size="260px 40px" textSize="11px" text="$l10n_dr_col_incomingProducts" />
            <Text profile="SDHeaderLeft" position="312px 0px" size="240px 40px" textSize="11px" text="$l10n_dr_col_heldSlashMax" />
            <Text profile="SDHeaderLeft" position="560px 0px" size="115px 40px" textSize="11px" text="$l10n_dr_col_freeStorage" />
            <Text profile="SDHeaderLeft" position="683px 0px" size="140px 40px" textSize="11px" text="$l10n_dr_col_received" />
            <Text profile="SDHeaderLeft" position="831px 0px" size="259px 40px" textSize="11px" text="$l10n_dr_col_distribution" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>
        <GuiElement profile="SDList" id="inputPanel" position="390px -136px" size="1090px 280px">
            <SmoothList profile="SDList" id="inputList" position="0px 0px" size="1090px 280px"
                        onSelectionChanged="onInputSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1090px 42px" onClick="onClickInputRow">
                    <!-- full-width overlay for the "+N blocked" notice row; hidden on every normal row -->
                    <Text profile="SDRowCell" position="44px 0px" size="1030px 42px" textSize="12px" name="noticeText" visible="false" />
                    <Bitmap position="12px 9px" size="24px 24px" name="fillIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell" position="44px 0px"  size="260px 42px" textSize="12px" name="fillName" />
                    <Text profile="SDRowCell" position="312px 0px" size="240px 42px" textSize="12px" name="heldText" />
                    <Text profile="SDRowCell" position="560px 0px" size="115px 42px" textSize="12px" name="remainingText" />
                    <Text profile="SDRowCell" position="683px 0px" size="140px 42px" textSize="12px" name="recvText" />
                    <Text profile="SDRowCell" position="831px 0px" size="259px 42px" textSize="12px" name="statusText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 280px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 272px" dataElementId="inputList" id="inputSlider" />
            </ThreePartBitmap>
        </GuiElement>

        <!-- OUTGOING PRODUCTS. DISTRIBUTED is everything that left: distributed + stored/moved + sold,
             with the sale value in brackets. A silo produces nothing, so there is no PRODUCED column. -->
        <Bitmap profile="SDList" position="390px -426px" size="1090px 40px">
            <Text profile="SDHeaderLeft" position="44px 0px"  size="185px 40px" textSize="11px" text="$l10n_dr_col_outgoingProducts" />
            <Text profile="SDHeaderLeft" position="237px 0px" size="220px 40px" textSize="11px" text="$l10n_dr_col_heldMax" />
            <Text profile="SDHeaderLeft" position="465px 0px" size="110px 40px" textSize="11px" text="$l10n_dr_col_freeStorage" />
            <Text profile="SDHeaderLeft" position="583px 0px" size="130px 40px" textSize="11px" text="$l10n_dr_col_distributed" />
            <Text profile="SDHeaderLeft" position="721px 0px" size="235px 40px" textSize="11px" text="$l10n_dr_col_outputMode" />
            <Text profile="SDHeaderLeft" position="964px 0px" size="126px 40px" textSize="11px" text="$l10n_dr_col_status" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>

        <GuiElement profile="SDList" position="390px -470px" size="1090px 340px">
            <SmoothList profile="SDList" id="detailList" position="0px 0px" size="1090px 340px"
                        focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1090px 42px" onClick="onClickDetailRow">
                    <!-- full-width overlay for the "+N blocked" notice row; hidden on every normal row -->
                    <Text profile="SDRowCell" position="44px 0px" size="1030px 42px" textSize="12px" name="noticeText" visible="false" />
                    <Bitmap position="12px 9px" size="24px 24px" name="fillIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell" position="44px 0px"  size="185px 42px" textSize="12px" name="fillName" />
                    <Text profile="SDRowCell" position="237px 0px" size="220px 42px" textSize="12px" name="heldText" />
                    <Text profile="SDRowCell" position="465px 0px" size="110px 42px" textSize="12px" name="remainingText" />
                    <Text profile="SDRowCell" position="583px 0px" size="130px 42px" textSize="12px" name="distText" />
                    <!-- MODE carries the mode AND its sell timing ("Distribute + Sell - Sell Immediately"),
                         so it needs real room: at 180px/14px text it truncated to "Distribute + S...", which
                         reads as plain Distribute and hid a silo that was actually selling everything it
                         received. 235px at 12px is ~39 characters, clear of that string. -->
                    <Text profile="SDRowCell" position="721px 0px" size="235px 42px" textSize="12px" name="modeText" />
                    <Text profile="SDRowCell" position="964px 0px" size="126px 42px" textSize="12px" name="statusText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 340px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 332px" dataElementId="detailList" id="detailSlider" />
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>

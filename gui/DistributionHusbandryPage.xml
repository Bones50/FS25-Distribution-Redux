<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="distributionHusbandryPage">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_animals"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="Distribution - Animal Husbandry"/>
        </GuiElement>

        <!-- left: husbandry list -->
        <Bitmap profile="SDList" position="0px -46px" size="370px 40px">
            <Text profile="SDHeaderLeft" position="16px 0px" size="340px 40px" text="HUSBANDRIES" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>
        <SmoothList profile="SDList" id="assetList" position="0px -90px" size="370px 720px"
                    onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
            <ListItem profile="SDListItem" name="rowTemplate" size="370px 52px" onClick="onClickAsset">
                <Bitmap position="10px 6px" size="48px 40px" name="assetIcon" imageColor="1 1 1 1" />
                <!-- renamed buildings: player's name on top, original store name beneath (positive Y = up) -->
                <Text profile="SDRowCell" position="66px 10px"  size="180px 26px" textSize="17px" name="assetName" />
                <Text profile="SDRowCell" position="66px -12px" size="180px 20px" textSize="13px" name="assetOrigName" />
                <Text profile="SDRowCell" position="252px 0px" size="106px 52px" textSize="15px" name="assetType" />
            </ListItem>
        </SmoothList>

        <!-- timescale for every figure on this page, plus a pointer to the Overview tab, which carries the
             per-product breakdown these columns deliberately no longer repeat -->
        <Bitmap profile="SDList" position="390px -46px" size="1090px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="110px 40px" textSize="18px" text="Timescale"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="130px 0px" size="380px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="periodOption" onClick="onPeriodChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
            <Text profile="SDHeaderLeft" position="530px 0px" size="550px 40px" textSize="14px"
                  text="Full breakdown + supply chains: Overview tab" />
        </Bitmap>

        <!-- right: incoming products (inputs / demand) -->
        <Bitmap profile="SDList" position="390px -92px" size="1090px 40px">
            <Text profile="SDHeaderLeft" position="44px 0px"  size="215px 40px" textSize="11px" text="INCOMING PRODUCTS" />
            <Text profile="SDHeaderLeft" position="267px 0px" size="225px 40px" textSize="11px" text="HELD / MAX" />
            <Text profile="SDHeaderLeft" position="500px 0px" size="110px 40px" textSize="11px" text="FREE STORAGE" />
            <Text profile="SDHeaderLeft" position="618px 0px" size="110px 40px" textSize="11px" text="RECEIVED" />
            <Text profile="SDHeaderLeft" position="736px 0px" size="110px 40px" textSize="11px" text="CONSUMED" />
            <Text profile="SDHeaderLeft" position="854px 0px" size="236px 40px" textSize="11px" text="DISTRIBUTION" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>
        <GuiElement profile="SDList" position="390px -136px" size="1090px 280px">
            <SmoothList profile="SDList" id="inputList" position="0px 0px" size="1090px 280px"
                        onSelectionChanged="onInputSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1090px 42px" onClick="onClickInputRow">
                    <!-- full-width overlay for the "+N blocked" notice row; hidden on every normal row -->
                    <Text profile="SDRowCell" position="44px 0px" size="1030px 42px" textSize="12px" name="noticeText" visible="false" />
                    <Bitmap position="12px 9px" size="24px 24px" name="fillIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell" position="44px 0px"  size="215px 42px" textSize="12px" name="fillName" />
                    <Text profile="SDRowCell" position="267px 0px" size="225px 42px" textSize="12px" name="heldText" />
                    <Text profile="SDRowCell" position="500px 0px" size="110px 42px" textSize="12px" name="remainingText" />
                    <Text profile="SDRowCell" position="618px 0px" size="110px 42px" textSize="12px" name="recvText" />
                    <Text profile="SDRowCell" position="736px 0px" size="110px 42px" textSize="12px" name="consumedText" />
                    <Text profile="SDRowCell" position="854px 0px" size="236px 42px" textSize="12px" name="statusText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 280px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 272px" dataElementId="inputList" id="inputSlider" />
            </ThreePartBitmap>
        </GuiElement>

        <!-- outgoing products. DISTRIBUTED is everything that left: distributed + stored/moved + sold,
             with the sale value in brackets. -->
        <Bitmap profile="SDList" position="390px -426px" size="1090px 40px">
            <Text profile="SDHeaderLeft" position="44px 0px"  size="155px 40px" textSize="11px" text="OUTGOING PRODUCTS" />
            <Text profile="SDHeaderLeft" position="207px 0px" size="210px 40px" textSize="11px" text="HELD (MAX)" />
            <Text profile="SDHeaderLeft" position="425px 0px" size="100px 40px" textSize="11px" text="FREE STORAGE" />
            <Text profile="SDHeaderLeft" position="533px 0px" size="95px 40px"  textSize="11px" text="PRODUCED" />
            <Text profile="SDHeaderLeft" position="636px 0px" size="115px 40px" textSize="11px" text="DISTRIBUTED" />
            <Text profile="SDHeaderLeft" position="759px 0px" size="215px 40px" textSize="11px" text="OUTPUT MODE" />
            <Text profile="SDHeaderLeft" position="982px 0px" size="108px 40px" textSize="11px" text="STATUS" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>
        <GuiElement profile="SDList" position="390px -470px" size="1090px 340px">
            <SmoothList profile="SDList" id="outputList" position="0px 0px" size="1090px 340px"
                        onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1090px 42px" onClick="onClickOutputRow">
                    <!-- full-width overlay for the "+N blocked" notice row; hidden on every normal row -->
                    <Text profile="SDRowCell" position="44px 0px" size="1030px 42px" textSize="12px" name="noticeText" visible="false" />
                    <Bitmap position="12px 9px" size="24px 24px" name="fillIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell" position="44px 0px"  size="155px 42px" textSize="12px" name="fillName" />
                    <!-- HELD sits next to the product and takes the widest slot: it is the only cell that
                         carries three figures ("473 L (150,000 L) + 3,000 L (3p)") and it was truncating. -->
                    <Text profile="SDRowCell" position="207px 0px" size="210px 42px" textSize="12px" name="heldText" />
                    <Text profile="SDRowCell" position="425px 0px" size="100px 42px" textSize="12px" name="remainingText" />
                    <Text profile="SDRowCell" position="533px 0px" size="95px 42px"  textSize="12px" name="prodText" />
                    <Text profile="SDRowCell" position="636px 0px" size="115px 42px" textSize="12px" name="distText" />
                    <!-- mode AND its sell timing share this cell ("Distribute + Sell - Sell Immediately") -->
                    <Text profile="SDRowCell" position="759px 0px" size="215px 42px" textSize="12px" name="modeText" />
                    <Text profile="SDRowCell" position="982px 0px" size="108px 42px" textSize="12px" name="statusText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 340px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 332px" dataElementId="outputList" id="outputSlider" />
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>

<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="distributionOverviewPage">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_statistics"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="Distribution - Overview"/>
        </GuiElement>

        <!-- Controls, two rows of two. Grey backing + explicit light text on each, because the base
             settings container renders white-on-white outside the settings frame.
             Row 1: what to filter by, and which one to show. Row 2: timescale and grouping. -->
        <Bitmap profile="SDList" position="0px -44px" size="700px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="130px 40px" textSize="18px" text="Filter by"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="150px 0px" size="550px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="filterModeOption" onClick="onFilterModeChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
        </Bitmap>
        <Bitmap profile="SDList" position="740px -44px" size="740px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="130px 40px" textSize="18px" text="Show"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="150px 0px" size="590px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="filterValueOption" onClick="onFilterValueChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
        </Bitmap>

        <Bitmap profile="SDList" position="0px -88px" size="700px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="130px 40px" textSize="18px" text="Timescale"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="150px 0px" size="550px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="periodOption" onClick="onPeriodChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
        </Bitmap>
        <Bitmap profile="SDList" position="740px -88px" size="740px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="130px 40px" textSize="18px" text="Grouping"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="150px 0px" size="590px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="groupOption" onClick="onGroupChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
        </Bitmap>

        <!-- table header. All figures are litres. HELD is a live stock reading, bracketed with how much
             room there is for it (for a product the building RECEIVES that is the Advanced Inputs "Max in"
             figure, not the raw tank); every other column is a flow totalled over the selected timescale.
             RECEIVED / DISTRIBUTED are what Distribution Redux moved; LOADED / UNLOADED are what was put
             in or taken out by hand (player, helper, other mod). -->
        <Bitmap profile="SDList" position="0px -140px" size="1480px 40px">
            <Text profile="SDHeaderLeft"  position="56px 0px"   size="160px 40px" text="BUILDING" />
            <Text profile="SDHeaderLeft"  position="244px 0px"  size="156px 40px" text="PRODUCT" />
            <Text profile="SDHeaderRight" position="406px 0px"  size="78px 40px"  textSize="11px" text="RECEIVED" />
            <Text profile="SDHeaderRight" position="488px 0px"  size="70px 40px"  textSize="11px" text="LOADED" />
            <Text profile="SDHeaderRight" position="562px 0px"  size="130px 40px" textSize="11px" text="CONSUMED (EXP.)" />
            <Text profile="SDHeaderRight" position="696px 0px"  size="78px 40px"  textSize="11px" text="UNLOADED" />
            <Text profile="SDHeaderRight" position="778px 0px"  size="250px 40px" textSize="11px" text="HELD (CAP)" />
            <Text profile="SDHeaderRight" position="1032px 0px" size="130px 40px" textSize="11px" text="PRODUCED (EXP.)" />
            <Text profile="SDHeaderRight" position="1166px 0px" size="78px 40px"  textSize="11px" text="DISTRIBUTED" />
            <Text profile="SDHeaderRight" position="1248px 0px" size="78px 40px"  textSize="11px" text="STORED/MOVED" />
            <Text profile="SDHeaderRight" position="1330px 0px" size="78px 40px"  textSize="11px" text="SOLD" />
            <Text profile="SDHeaderRight" position="1412px 0px" size="68px 40px"  textSize="11px" text="DISTR. COST" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>

        <!-- table body: one row per (building, product) -->
        <GuiElement profile="SDList" position="0px -184px" size="1480px 626px">
            <SmoothList profile="SDList" id="statsList" position="0px 0px" size="1480px 626px"
                        onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1480px 42px" onClick="onClickStatsRow">
                    <Bitmap position="8px 5px" size="44px 32px" name="assetIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell"  position="56px 0px"   size="160px 42px" textSize="12px" name="assetName" />
                    <Bitmap position="220px 12px" size="18px 18px" name="productIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell"  position="244px 0px"  size="156px 42px" textSize="12px" name="productName" />
                    <Text profile="SDRowCellR" position="406px 0px"  size="78px 42px"  textSize="12px" name="receivedText" />
                    <Text profile="SDRowCellR" position="488px 0px"  size="70px 42px"  textSize="12px" name="loadedText" />
                    <Text profile="SDRowCellR" position="562px 0px"  size="130px 42px" textSize="12px" name="consumedText" />
                    <Text profile="SDRowCellR" position="696px 0px"  size="78px 42px"  textSize="12px" name="unloadedText" />
                    <!-- HELD carries the longest string on the page: "473 L (150,000 L) + 3,000 L (3p)".
                         At 118px it truncated to "360 L (150,000 L) + ...", so it gets 250px, taken from
                         the flow columns either side that only ever hold a short figure or a dash. -->
                    <Text profile="SDRowCellR" position="778px 0px"  size="250px 42px" textSize="12px" name="heldText" />
                    <Text profile="SDRowCellR" position="1032px 0px" size="130px 42px" textSize="12px" name="producedText" />
                    <Text profile="SDRowCellR" position="1166px 0px" size="78px 42px"  textSize="12px" name="distributedText" />
                    <Text profile="SDRowCellR" position="1248px 0px" size="78px 42px"  textSize="12px" name="storedText" />
                    <Text profile="SDRowCellR" position="1330px 0px" size="78px 42px"  textSize="12px" name="soldText" />
                    <Text profile="SDRowCellR" position="1412px 0px" size="68px 42px"  textSize="12px" name="costText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 626px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 618px" dataElementId="statsList" id="statsSlider" />
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>

<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="distributionOverviewPage">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_statistics"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_dr_title_overview"/>
        </GuiElement>

        <!-- Controls, two rows of two. Grey backing + explicit light text on each, because the base
             settings container renders white-on-white outside the settings frame.
             Row 1: what to filter by, and which one to show. Row 2: timescale and grouping. -->
        <Bitmap profile="SDList" position="0px -44px" size="700px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="130px 40px" textSize="18px" text="$l10n_dr_lbl_filterBy"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="150px 0px" size="550px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="filterModeOption" onClick="onFilterModeChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
        </Bitmap>
        <Bitmap profile="SDList" position="740px -44px" size="740px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="130px 40px" textSize="18px" text="$l10n_dr_lbl_show"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="150px 0px" size="590px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="filterValueOption" onClick="onFilterValueChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
        </Bitmap>

        <Bitmap profile="SDList" position="0px -88px" size="700px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="130px 40px" textSize="18px" text="$l10n_dr_lbl_timescale"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="150px 0px" size="550px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="periodOption" onClick="onPeriodChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
        </Bitmap>
        <Bitmap profile="SDList" position="740px -88px" size="740px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="130px 40px" textSize="18px" text="$l10n_dr_lbl_grouping"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="150px 0px" size="590px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="groupOption" onClick="onGroupChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
        </Bitmap>

        <!-- table header. All figures are litres. HELD is a live stock reading, bracketed with how much
             room there is for it (for a product the building RECEIVES that is the Advanced Inputs "Max in"
             figure, not the raw tank); every other column is a flow totalled over the selected timescale.
             RECEIVED / DISTRIBUTED are what Distribution Redux moved; LOADED / UNLOADED are what was put
             in or taken out by hand (player, helper, other mod). -->
        <Bitmap profile="SDList" id="flowHeaderRow" position="0px -140px" size="1480px 40px">
            <Text profile="SDHeaderLeft"  position="56px 0px"   size="160px 40px" text="$l10n_dr_col_building" />
            <Text profile="SDHeaderLeft"  position="244px 0px"  size="156px 40px" text="$l10n_dr_col_product" />
            <Text profile="SDHeaderRight" position="406px 0px"  size="64px 40px"  textSize="11px" text="$l10n_dr_col_received" />
            <Text profile="SDHeaderRight" position="474px 0px"  size="54px 40px"  textSize="11px" text="$l10n_dr_col_loaded" />
            <Text profile="SDHeaderRight" position="532px 0px"  size="110px 40px" textSize="11px" text="$l10n_dr_col_consumedExp" />
            <Text profile="SDHeaderRight" position="646px 0px"  size="64px 40px"  textSize="11px" text="$l10n_dr_col_unloaded" />
            <Text profile="SDHeaderRight" position="714px 0px"  size="220px 40px" textSize="11px" text="$l10n_dr_col_heldMax" />
            <Text profile="SDHeaderRight" position="938px 0px"  size="80px 40px"  textSize="11px" text="$l10n_dr_col_freeStorage" />
            <Text profile="SDHeaderRight" position="1022px 0px" size="110px 40px" textSize="11px" text="$l10n_dr_col_producedExp" />
            <Text profile="SDHeaderRight" position="1136px 0px" size="72px 40px"  textSize="11px" text="$l10n_dr_col_distributed" />
            <Text profile="SDHeaderRight" position="1212px 0px" size="84px 40px"  textSize="11px" text="$l10n_dr_col_storedMoved" />
            <Text profile="SDHeaderRight" position="1300px 0px" size="118px 40px" textSize="11px" text="$l10n_dr_col_sold" />
            <Text profile="SDHeaderRight" position="1422px 0px" size="58px 40px"  textSize="11px" text="$l10n_dr_col_distrCost" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>

        <!-- SETTINGS VIEW header. Same first two columns as the flow header above (deliberately identical
             positions and widths, so toggling the view does not move the building or product column), then
             the Advanced Inputs configuration, then the Advanced Outputs configuration. A row fills only the
             side it plays: an (In) row leaves the output group blank, an (Out) row the input group, and an
             (In/Out) silo fills both. Kept as a SECOND header + list rather than retitling the flow one,
             because the two views need genuinely different column widths and repositioning cells at runtime
             would mean px-to-normalised arithmetic on the live layout (declined for the same reason in 5.33).
             DEST is "active/total" routable destinations for the product's CURRENT mode. -->
        <Bitmap profile="SDList" id="settingsHeaderRow" position="0px -140px" size="1480px 40px" visible="false">
            <Text profile="SDHeaderLeft"  position="56px 0px"   size="160px 40px" text="$l10n_dr_col_building" />
            <Text profile="SDHeaderLeft"  position="244px 0px"  size="156px 40px" text="$l10n_dr_col_product" />
            <Text profile="SDHeaderRight" position="406px 0px"  size="78px 40px"  textSize="11px" text="$l10n_dr_col_storageType" />
            <Text profile="SDHeaderRight" position="488px 0px"  size="124px 40px" textSize="11px" text="$l10n_dr_col_maxInPctL" />
            <Text profile="SDHeaderRight" position="616px 0px"  size="132px 40px" textSize="11px" text="$l10n_dr_col_heldOfMax" />
            <Text profile="SDHeaderRight" position="752px 0px"  size="112px 40px" textSize="11px" text="$l10n_dr_col_fillTarget" />
            <Text profile="SDHeaderRight" position="868px 0px"  size="80px 40px"  textSize="11px" text="$l10n_dr_col_inStatus" />
            <Text profile="SDHeaderRight" position="952px 0px"  size="56px 40px"  textSize="11px" text="$l10n_dr_col_lines" />
            <!-- OUT MODE carries the longest string on this header ("Distribute + Market Supply"), so it
                 takes 180px and the whole numeric band was re-pitched around it to still end at 1480. -->
            <Text profile="SDHeaderRight" position="1012px 0px" size="172px 40px" textSize="11px" text="$l10n_dr_col_outMode" />
            <Text profile="SDHeaderRight" position="1188px 0px" size="80px 40px"  textSize="11px" text="$l10n_dr_col_reserve" />
            <Text profile="SDHeaderRight" position="1272px 0px" size="80px 40px"  textSize="11px" text="$l10n_dr_col_priority" />
            <Text profile="SDHeaderRight" position="1356px 0px" size="44px 40px"  textSize="11px" text="$l10n_dr_col_dest" />
            <Text profile="SDHeaderRight" position="1404px 0px" size="76px 40px"  textSize="11px" text="$l10n_dr_col_outStatus" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>

        <!-- table body: one row per (building, product) -->
        <GuiElement profile="SDList" id="flowListBox" position="0px -184px" size="1480px 626px">
            <SmoothList profile="SDList" id="statsList" position="0px 0px" size="1480px 626px"
                        onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1480px 42px" onClick="onClickStatsRow">
                    <Bitmap position="8px 5px" size="44px 32px" name="assetIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell"  position="56px 0px"   size="160px 42px" textSize="12px" name="assetName" />
                    <Bitmap position="220px 12px" size="18px 18px" name="productIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell"  position="244px 0px"  size="156px 42px" textSize="12px" name="productName" />
                    <Text profile="SDRowCellR" position="406px 0px"  size="64px 42px"  textSize="12px" name="receivedText" />
                    <Text profile="SDRowCellR" position="474px 0px"  size="54px 42px"  textSize="12px" name="loadedText" />
                    <Text profile="SDRowCellR" position="532px 0px"  size="110px 42px" textSize="12px" name="consumedText" />
                    <Text profile="SDRowCellR" position="646px 0px"  size="64px 42px"  textSize="12px" name="unloadedText" />
                    <!-- HELD carries the longest string on the page: "473 L / 150,000 L (100%)" for an input
                         row, "473 L (150,000 L) + 3,000 L (3p)" for a palletised output. It keeps the widest
                         slot; REMAINING was fitted beside it by taking a few px from each of the narrow
                         columns, which only ever hold a short figure or a dash. Table still ends at 1480. -->
                    <Text profile="SDRowCellR" position="714px 0px"  size="220px 42px" textSize="12px" name="heldText" />
                    <Text profile="SDRowCellR" position="938px 0px"  size="80px 42px"  textSize="12px" name="remainingText" />
                    <Text profile="SDRowCellR" position="1022px 0px" size="110px 42px" textSize="12px" name="producedText" />
                    <Text profile="SDRowCellR" position="1136px 0px" size="72px 42px"  textSize="12px" name="distributedText" />
                    <!-- SOLD carries a figure AND its money in brackets, "78,000 (E40,950)", so it needs
                         far more than the plain-number columns beside it. STORED/MOVED gained a little
                         with it, its header having been clipped to "STORED/MOV...". -->
                    <Text profile="SDRowCellR" position="1212px 0px" size="84px 42px"  textSize="12px" name="storedText" />
                    <Text profile="SDRowCellR" position="1300px 0px" size="118px 42px" textSize="12px" name="soldText" />
                    <Text profile="SDRowCellR" position="1422px 0px" size="58px 42px"  textSize="12px" name="costText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 626px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 618px" dataElementId="statsList" id="statsSlider" />
            </ThreePartBitmap>
        </GuiElement>

        <!-- settings-view body. Same row pitch (42px) and the same first two cells as the flow list. -->
        <GuiElement profile="SDList" id="settingsListBox" position="0px -184px" size="1480px 626px" visible="false">
            <SmoothList profile="SDList" id="settingsList" position="0px 0px" size="1480px 626px"
                        onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1480px 42px" onClick="onClickStatsRow">
                    <Bitmap position="8px 5px" size="44px 32px" name="assetIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell"  position="56px 0px"   size="160px 42px" textSize="12px" name="assetName" />
                    <Bitmap position="220px 12px" size="18px 18px" name="productIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell"  position="244px 0px"  size="156px 42px" textSize="12px" name="productName" />
                    <Text profile="SDRowCellR" position="406px 0px"  size="78px 42px"  textSize="12px" name="typeText" />
                    <Text profile="SDRowCellR" position="488px 0px"  size="124px 42px" textSize="12px" name="maxInText" />
                    <Text profile="SDRowCellR" position="616px 0px"  size="132px 42px" textSize="12px" name="heldOfMaxText" />
                    <Text profile="SDRowCellR" position="752px 0px"  size="112px 42px" textSize="12px" name="fillTargetText" />
                    <Text profile="SDRowCellR" position="868px 0px"  size="80px 42px"  textSize="12px" name="inStatusText" />
                    <Text profile="SDRowCellR" position="952px 0px"  size="56px 42px"  textSize="12px" name="prodLinesText" />
                    <Text profile="SDRowCellR" position="1012px 0px" size="172px 42px" textSize="11px" name="outModeText" />
                    <Text profile="SDRowCellR" position="1188px 0px" size="80px 42px"  textSize="12px" name="reserveText" />
                    <Text profile="SDRowCellR" position="1272px 0px" size="80px 42px"  textSize="12px" name="priorityText" />
                    <Text profile="SDRowCellR" position="1356px 0px" size="44px 42px"  textSize="12px" name="destText" />
                    <Text profile="SDRowCellR" position="1404px 0px" size="76px 42px"  textSize="12px" name="outStatusText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 626px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 618px" dataElementId="settingsList" id="settingsSlider" />
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>

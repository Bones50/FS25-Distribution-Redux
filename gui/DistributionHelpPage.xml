<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="distributionHelpPage">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_options_help2"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_dr_title_help" name="drTitle" id="drTitle"/>
        </GuiElement>

        <!-- PAGE TABS, under the header. The title above names the mod and the page; these
             name the section within it, on their own line, the way Husbandry Redux's page does.
             Costs the content 46px, which the page takes by ending at -856 instead of -810,
             the depth the User Guide page has always used, so every list keeps its height.

             SIX slots, hidden when unused so the strip never re-tiles (5.37). The count MUST
             match SmartDistribution.PAGE_TAB_MAX; tools/check_lists.py pins the two together,
             because a cap raised without slots silently drops tabs (the 5.92b failure).
             BACKGROUND BEFORE BUTTON in each pair: children draw in order (5.86). -->
        <Bitmap profile="SDList" position="0px 0px" size="1480px 40px" name="drTabStrip" id="drTabStrip">
            <Button profile="SDHeaderTabArrow" position="0px 0px" size="40px 40px"
                    name="drTabPrev" id="drTabPrev" onClick="onPageTabPrev" />
            <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg"
                             position="48px 0px" size="200px 40px" name="drTabBg1" id="drTabBg1"/>
            <Button profile="fs25_subCategorySelectorTabbedTab" position="48px 0px" size="200px 40px"
                    textAutoWidth="false" name="drTabBtn1" id="drTabBtn1" onClick="onPageTab1"/>
            <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg"
                             position="256px 0px" size="200px 40px" name="drTabBg2" id="drTabBg2"/>
            <Button profile="fs25_subCategorySelectorTabbedTab" position="256px 0px" size="200px 40px"
                    textAutoWidth="false" name="drTabBtn2" id="drTabBtn2" onClick="onPageTab2"/>
            <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg"
                             position="464px 0px" size="200px 40px" name="drTabBg3" id="drTabBg3"/>
            <Button profile="fs25_subCategorySelectorTabbedTab" position="464px 0px" size="200px 40px"
                    textAutoWidth="false" name="drTabBtn3" id="drTabBtn3" onClick="onPageTab3"/>
            <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg"
                             position="672px 0px" size="200px 40px" name="drTabBg4" id="drTabBg4"/>
            <Button profile="fs25_subCategorySelectorTabbedTab" position="672px 0px" size="200px 40px"
                    textAutoWidth="false" name="drTabBtn4" id="drTabBtn4" onClick="onPageTab4"/>
            <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg"
                             position="880px 0px" size="200px 40px" name="drTabBg5" id="drTabBg5"/>
            <Button profile="fs25_subCategorySelectorTabbedTab" position="880px 0px" size="200px 40px"
                    textAutoWidth="false" name="drTabBtn5" id="drTabBtn5" onClick="onPageTab5"/>
            <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg"
                             position="1088px 0px" size="200px 40px" name="drTabBg6" id="drTabBg6"/>
            <Button profile="fs25_subCategorySelectorTabbedTab" position="1088px 0px" size="200px 40px"
                    textAutoWidth="false" name="drTabBtn6" id="drTabBtn6" onClick="onPageTab6"/>
            <Button profile="SDHeaderTabArrow" position="1296px 0px" size="40px 40px"
                    name="drTabNext" id="drTabNext" onClick="onPageTabNext" />
        </Bitmap>



        <!-- left: topic list (table of contents) -->
        <GuiElement profile="SDList" position="40px -96px" size="460px 760px">
            <SmoothList profile="SDList" id="topicList" position="0px 0px" size="460px 760px"
                        onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItem" name="rowTemplate" size="460px 52px" onClick="onClickTopic">
                    <Text profile="SDRowCell" position="18px 0px" size="424px 52px" textSize="20px" name="topicName" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 760px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 752px" dataElementId="topicList" id="topicSlider" />
            </ThreePartBitmap>
        </GuiElement>

        <!-- right: selected topic body -->
        <GuiElement profile="SDList" position="540px -96px" size="1180px 760px">
            <SmoothList profile="SDList" id="bodyList" position="0px 0px" size="1180px 760px"
                        focusChangeTop="nil" focusChangeBottom="nil">
                <!-- No textSize override: SDBodyCell already resolves to 16px, which is what the base
                     game uses for body copy (fs25_dialogText). The 18px override here was the only
                     reason the guide read larger than every other text panel in the game. -->
                <ListItem profile="SDBodyItem" name="rowTemplate" size="1180px 30px" onClick="onClickBodyRow">
                    <Text profile="SDBodyCell" position="6px 0px" size="1168px 30px" name="bodyLine" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 760px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 752px" dataElementId="bodyList" id="bodyListSlider" />
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>

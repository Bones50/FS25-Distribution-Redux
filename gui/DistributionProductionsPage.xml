<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="distributionProductionsPage">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_productionChains"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="Distribution - Productions"/>
        </GuiElement>

        <!-- left: production building list -->
        <Bitmap profile="SDList" position="0px -46px" size="370px 40px">
            <Text profile="SDHeaderLeft" position="16px 0px" size="340px 40px" text="PRODUCTIONS" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>
        <SmoothList profile="SDList" id="assetList" position="0px -90px" size="370px 720px"
                    onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
            <ListItem profile="SDListItem" name="rowTemplate" size="370px 52px" onClick="onClickAsset">
                <Bitmap position="10px 6px" size="48px 40px" name="assetIcon" imageColor="1 1 1 1" />
                <!-- renamed buildings: player's name on top, original store name beneath as a secondary label.
                     NOTE: in this list row, positive Y moves UP - so the secondary line uses a negative Y. -->
                <Text profile="SDRowCell" position="66px 10px"  size="292px 26px" textSize="17px" name="assetName" />
                <Text profile="SDRowCell" position="66px -12px" size="292px 20px" textSize="13px" name="assetOrigName" />
            </ListItem>
        </SmoothList>

        <!-- timescale for every figure on this page, plus a pointer to the Overview tab, which carries the
             per-product breakdown these columns deliberately no longer repeat -->
        <Bitmap profile="SDList" position="390px -45px" size="1090px 40px">
            <Text profile="SDRowCell" position="16px 0px" size="110px 40px" textSize="18px" text="Timescale"/>
            <Bitmap profile="fs25_multiTextOptionContainer" position="130px 0px" size="380px 40px" imageColor="0 0 0 0">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="periodOption" onClick="onPeriodChanged"
                                 textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>
            <Text profile="SDHeaderLeft" position="530px 0px" size="550px 40px" textSize="14px"
                  text="Full breakdown + supply chains: Overview tab" />
        </Bitmap>

        <!-- ===================== SECTION 1: INCOMING MATERIALS (inputs) =====================
             Columns match the Animal Husbandry page (name / RECEIVED / CONSUMED / HELD (L) / DISTRIBUTION)
             and the rows are selectable, ready for the input drill-down. -->
        <Bitmap profile="SDList" position="390px -91px" size="1090px 40px">
            <Text profile="SDHeaderLeft" position="44px 0px"  size="215px 40px" textSize="11px" text="INCOMING MATERIALS" />
            <Text profile="SDHeaderLeft" position="267px 0px" size="225px 40px" textSize="11px" text="HELD / MAX" />
            <Text profile="SDHeaderLeft" position="500px 0px" size="110px 40px" textSize="11px" text="REMAINING" />
            <Text profile="SDHeaderLeft" position="618px 0px" size="110px 40px" textSize="11px" text="RECEIVED" />
            <Text profile="SDHeaderLeft" position="736px 0px" size="110px 40px" textSize="11px" text="CONSUMED" />
            <Text profile="SDHeaderLeft" position="854px 0px" size="236px 40px" textSize="11px" text="DISTRIBUTION" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>

        <GuiElement profile="SDList" position="390px -133px" size="1090px 152px">
            <SmoothList profile="SDList" id="inputList" position="0px 0px" size="1090px 152px"
                        onSelectionChanged="onInputSelectionChanged" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1090px 42px" onClick="onClickInputRow">
                    <!-- full-width overlay for the "+N blocked" notice row; hidden on every normal row -->
                    <Text profile="SDRowCell" position="44px 0px" size="1030px 42px" textSize="12px" name="noticeText" visible="false" />
                    <Bitmap position="12px 9px" size="24px 24px" name="fillIcon" imageColor="1 1 1 1" />
                    <Text profile="SDRowCell" position="44px 0px"  size="215px 42px" textSize="12px" name="name" />
                    <Text profile="SDRowCell" position="267px 0px" size="225px 42px" textSize="12px" name="amount" />
                    <Text profile="SDRowCell" position="500px 0px" size="110px 42px" textSize="12px" name="remainingText" />
                    <Text profile="SDRowCell" position="618px 0px" size="110px 42px" textSize="12px" name="received" />
                    <Text profile="SDRowCell" position="736px 0px" size="110px 42px" textSize="12px" name="consumed" />
                    <Text profile="SDRowCell" position="854px 0px" size="236px 42px" textSize="12px" name="statusText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 152px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 144px" dataElementId="inputList" id="inputSlider" />
            </ThreePartBitmap>
        </GuiElement>

        <!-- ===================== SECTION 2: PRODUCTION LINES (selectable, toggle on/off) ===================== -->
        <Bitmap profile="SDList" position="390px -291px" size="1090px 40px">
            <Text profile="SDHeaderLeft"  position="16px 0px"  size="700px 40px" textSize="11px" text="PRODUCTION LINES" />
            <Text profile="SDHeaderLeft"  position="726px 0px" size="130px 40px" textSize="11px" text="STATUS" />
            <Text profile="SDHeaderRight" position="866px 0px" size="224px 40px" textSize="11px" text="TARGET /mo" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>

        <GuiElement profile="SDList" position="390px -333px" size="1090px 152px">
            <SmoothList profile="SDList" id="lineList" position="0px 0px" size="1090px 152px"
                        onSelectionChanged="onListSelectionChanged" focusChangeTop="nil" focusChangeBottom="outputList">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1090px 42px" onClick="onClickLineRow">
                    <Text profile="SDRowCell"  position="16px 0px"  size="700px 42px" textSize="12px" name="name" />
                    <Text profile="SDRowCell"  position="726px 0px" size="130px 42px" textSize="12px" name="status" />
                    <Text profile="SDRowCellR" position="866px 0px" size="224px 42px" textSize="12px" name="prodMo" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 152px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 144px" dataElementId="lineList" id="lineSlider" />
            </ThreePartBitmap>
        </GuiElement>

        <!-- ===================== SECTION 3: OUTGOING PRODUCTS (selectable, cycle distribution) =====================
             DISTRIBUTED is everything that left: distributed + stored/moved + sold, with the sale value in
             brackets. The separate DISTR / STORED / SOLD split now lives on the Overview tab. -->
        <Bitmap profile="SDList" position="390px -491px" size="1090px 40px">
            <Text profile="SDHeaderLeft"  position="44px 0px"  size="155px 40px" textSize="11px" text="OUTGOING PRODUCTS" />
            <Text profile="SDHeaderRight" position="207px 0px" size="210px 40px" textSize="11px" text="HELD (MAX)" />
            <Text profile="SDHeaderRight" position="425px 0px" size="100px 40px" textSize="11px" text="REMAINING" />
            <Text profile="SDHeaderRight" position="533px 0px" size="95px 40px"  textSize="11px" text="PRODUCED" />
            <Text profile="SDHeaderRight" position="636px 0px" size="115px 40px" textSize="11px" text="DISTRIBUTED" />
            <Text profile="SDHeaderLeft"  position="759px 0px" size="215px 40px" textSize="11px" text="OUTPUT MODE" />
            <Text profile="SDHeaderLeft"  position="982px 0px" size="108px 40px" textSize="11px" text="STATUS" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
        </Bitmap>

        <GuiElement profile="SDList" position="390px -533px" size="1090px 277px">
            <SmoothList profile="SDList" id="outputList" position="0px 0px" size="1090px 277px"
                        onSelectionChanged="onListSelectionChanged" focusChangeTop="lineList" focusChangeBottom="nil">
                <ListItem profile="SDListItemStats" name="rowTemplate" size="1090px 42px" onClick="onClickOutputRow">
                    <!-- full-width overlay for the "+N blocked" notice row; hidden on every normal row -->
                    <Text profile="SDRowCell" position="44px 0px" size="1030px 42px" textSize="12px" name="noticeText" visible="false" />
                    <Bitmap position="12px 9px" size="24px 24px" name="fillIcon" imageColor="1 1 1 1" />
                    <Text   profile="SDRowCell"  position="44px 0px"  size="155px 42px" textSize="12px" name="name" />
                    <!-- widest cell on the row: "450 L (5,000 L) + 5,000 L (5p)" -->
                    <Text   profile="SDRowCellR" position="207px 0px" size="210px 42px" textSize="12px" name="amount" />
                    <Text   profile="SDRowCellR" position="425px 0px" size="100px 42px" textSize="12px" name="remainingText" />
                    <Text   profile="SDRowCellR" position="533px 0px" size="95px 42px"  textSize="12px" name="produced" />
                    <Text   profile="SDRowCellR" position="636px 0px" size="115px 42px" textSize="12px" name="distr" />
                    <Text   profile="SDRowCell"  position="759px 0px" size="215px 42px" textSize="12px" name="method" />
                    <Text   profile="SDRowCell"  position="982px 0px" size="108px 42px" textSize="12px" name="statusText" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="12px 0px" size="12px 277px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 269px" dataElementId="outputList" id="outputSlider" />
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>

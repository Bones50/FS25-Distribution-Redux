                <Text profile="SDRowCell" position="66px -12px" size="292px 20px" textSize="13px" name="assetOrigName" />
            </ListItem>
        </SmoothList>

        <!-- THE SELECTOR ROW, full width and left aligned on the y=-46 row under the tab strip, which
             is the layout Husbandry Redux's own page uses and the row every DR page had left EMPTY.
             It used to sit in the right column level with the building list's header, which spent a
             table row on it and left this one blank. Moving it here gives the right column that row
             back, so the tables below start at -92 beside the building list rather than 46px lower.
             Carries the timescale for every figure on this page, plus a pointer to the Overview tab,
             which has the per-product breakdown these columns deliberately no longer repeat. -->
        <Bitmap profile="SDList" position="0px -46px" size="1480px 40px">

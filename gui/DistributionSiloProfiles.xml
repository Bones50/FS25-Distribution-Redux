<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUIProfiles>
    <Presets>
        <Preset name="sdColorWhite" value="1 1 1 1"/>
    </Presets>

    <Profile name="SDHeaderLeft" extends="baseReference">
        <imageColor value="0 0 0 0" />
        <textFocusedColor value="$preset_fs25_colorMainHighlight" />
        <textHighlightedColor value="$preset_fs25_colorMainHighlight" />
        <textSize value="16px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textColor value="$preset_colorWhite_50" />
        <textAlignment value="left" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>

    <Profile name="SDList" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
    </Profile>

    <!-- A SECOND ICON IN THE CORNER OF A TAB, so one tab can say two things.
         ANCHORED, not positioned from the top-left, because fs25_tabListItem's own
         size lives in dataS.gar and cannot be read - an anchor needs no such number
         and lands in the corner whatever the cell turns out to be.
         anchorTopRight IS THE ONLY CORNER PROFILE THIS MOD CAN PROVE: it is used a
         dozen times across these layouts. anchorBottomRight and pivotBottomRight
         were written here first and are used NOWHERE else in the mod or in any
         installed mod, so they are names I could not verify - and 5.64 records that
         an unknown profile does not error, it falls back to a default with no
         positioning at all, which is exactly how a badge ends up in the middle of
         the screen. The base profile set is inside dataS.gar and unreadable.
         THE OFFSET MUST CLEAR THE BADGE'S OWN WIDTH. anchorTopRight pins the
         element's TOP-LEFT corner - the default pivot - to the tile's top-RIGHT
         corner, so at x=0 the whole badge sits OUTSIDE the tile. The first version
         used -4px and reported exactly that: 22px wide, 4px pulled back, 18px
         hanging off the tile (screenshot 2026-08-31). x must therefore be
         -(width + inset), so it moves with the size and cannot drift apart again.
         SIZE, measured rather than guessed at twice: the strip is 169 SCREEN px on
         the reported 3441-wide display, and an unwidened GUI px covers
         (1/1920) * g_aspectScaleX * 3441 = 1.334 screen px there - so the tile is
         about 125 GUI px and the tab's own icon about 52. At 22px the badge was a
         SIXTH of the tile and read as a speck; 40px stands beside the icon rather
         than sitting on it, which is what "a combination of the two" asks for.
         If the inset needs a nudge it is an XML-only change - a soft menu reload,
         no restart (1.4). -->
    <Profile name="SDTabBadge" extends="baseReference" with="anchorTopRight">
        <size value="40px 40px" />
        <position value="-46px -6px" />
        <imageColor value="$preset_colorWhite" />
    </Profile>

    <Profile name="SDListItem" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="56px"/>
        <imageColor value="$preset_fs25_colorGrey" />
        <imageSelectedColor value="$preset_fs25_colorMainHighlight" />
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50" />
    </Profile>

    <Profile name="SDRowCell" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="false" />
        <textSize value="18px" />
        <textAlignment value="left" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainDark" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>

    <!-- Help window: topic-content rows (plain, non-highlighting text lines). -->
    <Profile name="SDBodyItem" extends="baseReference" with="anchorTopStretchingX">
        <height value="27px"/>
        <imageColor value="0 0 0 0" />
        <imageSelectedColor value="0 0 0 0" />
        <imageFocusedColor value="0 0 0 0" />
    </Profile>

    <Profile name="SDBodyCell" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="false" />
        <textSize value="16px" />
        <textAlignment value="left" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainLight" />
        <textFocusedColor value="$preset_fs25_colorMainLight" />
    </Profile>

    <!-- Numeric columns. These were RIGHT-aligned; every table in the mod is now LEFT-aligned so a column
         reads down a single edge instead of some ragged-left and some ragged-right in adjacent lists.
         The profile NAMES are kept so no page layout has to change: "R" now means "the numeric variant",
         and the alignment lives in one place if it is ever revisited. -->
    <Profile name="SDHeaderRight" extends="SDHeaderLeft">
        <textAlignment value="left" />
    </Profile>

    <Profile name="SDRowCellR" extends="SDRowCell">
        <textAlignment value="left" />
    </Profile>

    <!-- STORAGE BAR labels: the held litres with their share on the left, the tank's capacity on the
         right, on a line under the bar.
         NO `with` ANCHOR, AND THAT IS THE WHOLE POINT. These first extended SDRowCell, which carries
         anchorStretchingYLeft, so each label STRETCHED from its own y down to the bottom of the 42px row
         and centred its text in whatever band was left. That is what put them roughly three quarters of
         a line too low and made the widget look unaligned with its row. Extending baseReference with no
         anchor honours the 15px box, and textVerticalAlignment centres the text inside THAT.
         RIGHT alignment is the one place DR still wants it. 5.22 flipped every DATA column to the left so
         a table reads as one block, but the capacity is tied to the right hand END OF A BAR rather than
         to a column, so it must sit flush against it however long the figure is. Kept here so alignment
         stays in one file, exactly as 5.22 left it. -->
    <Profile name="SDBarLabel" extends="baseReference">
        <textBold value="false" />
        <textSize value="11px" />
        <textAlignment value="left" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainDark" />
    </Profile>
    <Profile name="SDBarLabelRight" extends="SDBarLabel">
        <textAlignment value="right" />
    </Profile>

    <!-- The "+3" beside the pallet icon, drawn ON the storage bar rather than beside it. All four
         colours are set to the SAME value: this chip sits over the fills and must not dim or shift
         when the row happens to be the selected one, the way TextElement:getColor would otherwise make
         it (it prefers textFocusedSelectedColor / textSelectedColor / textFocusedColor over textColor
         whenever the row is in those states), the finding 5.77b records for SDInfoCell. -->
    <Profile name="SDBarPalletCount" extends="SDBarLabelRight">
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainLight" />
        <textFocusedColor value="$preset_fs25_colorMainLight" />
        <textFocusedSelectedColor value="$preset_fs25_colorMainLight" />
    </Profile>

    <!-- CENTRED numeric columns (RECEIVED / DISTRIBUTED on the merged storage table) and their headers.
         5.22 flipped every DATA column to the left so a table reads as one block, and that still holds
         for the wide cells; these two carry a single short figure in a narrow column, where centring
         keeps the header sitting over its own numbers instead of drifting left of them.
         The header and the row cell share x and width, so centring both lines them up exactly. -->
    <Profile name="SDRowCellCenter" extends="SDRowCell">
        <textAlignment value="center" />
    </Profile>
    <Profile name="SDHeaderCenter" extends="SDHeaderLeft">
        <textAlignment value="center" />
    </Profile>

    <!-- THE ROUTING GRAPH's five column headings. SDHeaderCenter is a TABLE header: colorWhite_50
         reads correctly above dense rows and disappears above a wide empty canvas, where these
         five words are the only thing between the controls and the graph. Full white, and the
         size is set on the elements. Reported 2026-09-23: "they just get lost in the page". -->
    <Profile name="SDGraphHeader" extends="SDHeaderCenter">
        <textColor value="$preset_colorWhite" />
    </Profile>

    <!-- RIGHT-aligned data cell. Used by the IN half of the combined status so it hugs the "/" and the
         gap either side of the separator is the same on every row, whatever the word length. -->
    <Profile name="SDRowCellRight" extends="SDRowCell">
        <textAlignment value="right" />
    </Profile>

    <!-- Fill percentage (green like the base production screen). -->
    <Profile name="SDRowCellPct" extends="SDRowCell">
        <textAlignment value="left" />
        <textColor value="$preset_fs25_colorMainHighlight" />
        <textSelectedColor value="$preset_fs25_colorMainHighlight" />
    </Profile>

    <!-- Compact 38px data rows (selectable; used by the Outputs list). Row pitch
         comes from the profile <height>, NOT the ListItem instance size. -->
    <Profile name="SDListItemData" extends="SDListItem">
        <height value="38px"/>
    </Profile>
    <!-- Overview tab: nine columns per row, so the pitch is set by the building thumbnail (34px) rather
         than the text. Row pitch comes from this <height>, NOT the ListItem instance size. -->
    <Profile name="SDListItemStats" extends="SDListItem">
        <height value="42px"/>
    </Profile>
    <!-- 42px INFO rows: same pitch as SDListItemStats, but never highlighted. The Advanced Inputs dialog
         now has TWO lists, and only the upper one is an action target. The Block / Max / Target buttons
         act on its selected row, so that highlight must stay visible even when the list is not focused.
         A second highlighted row in the lower table would make it ambiguous which one the buttons mean. -->
    <Profile name="SDListItemStatsInfo" extends="SDListItemStats">
        <imageSelectedColor value="$preset_fs25_colorGrey" />
        <imageFocusedColor value="$preset_fs25_colorGrey" />
    </Profile>
    <!-- Info-only rows (top / Inputs section): compact + never show a selection/focus highlight. -->
    <Profile name="SDListItemInfo" extends="SDListItemData">
        <imageSelectedColor value="$preset_fs25_colorGrey" />
        <imageFocusedColor value="$preset_fs25_colorGrey" />
    </Profile>
    <Profile name="SDInfoCell" extends="SDRowCell">
        <textSelectedColor value="$preset_fs25_colorMainLight" />
        <textFocusedColor value="$preset_fs25_colorMainLight" />
    </Profile>
    <Profile name="SDInfoCellR" extends="SDRowCellR">
        <textSelectedColor value="$preset_fs25_colorMainLight" />
        <textFocusedColor value="$preset_fs25_colorMainLight" />
    </Profile>
    <Profile name="SDInfoCellPct" extends="SDRowCellPct">
        <textSelectedColor value="$preset_fs25_colorMainHighlight" />
        <textFocusedColor value="$preset_fs25_colorMainHighlight" />
    </Profile>
    <!-- centered box for the spawn pop-up (Distribution Redux's own dialog).
         Extends the base-game dialog background so it renders as a small centered window. -->
    <Profile name="SDSpawnDialogBox" extends="fs25_dialogBg">
        <size value="720px 560px" />
    </Profile>
    <!-- wider box for the Advanced window (two lists side by side) -->
    <!-- The reserve entry box. The stock dialog text input is sized for a dialog built around it
         (~390px); a reserve is at most nine digits, so this is cut to 170px and left-anchored to sit
         inside the header-style bar that carries it. Anchoring is overridden as well as size because
         the stock profile places itself, which is why an absolute position on the element alone was
         ignored. -->
    <Profile name="SDReserveInput" extends="fs25_dialogTextInput" with="anchorStretchingYLeft">
        <size value="170px 34px" />
    </Profile>
    <Profile name="SDAdvDialogBox" extends="fs25_dialogBg">
        <size value="1400px 780px" />
    </Profile>
    <!-- Advanced INPUTS only. It carries two stacked tables: the input products, and the potential
         sources for whichever one is selected, so it needs more height than the Advanced OUTPUTS
         dialog, which shares SDAdvDialogBox and must NOT grow with it. Its own profile rather than a
         bigger shared one, so a change here can never move a dialog it was not aimed at. -->
    <!-- THE SETTINGS LIST, SHRUNK FROM THE TOP to clear the page tab strip.
         fs25_settingsLayout is 100% x 100% with anchors "0 1 0 1" and pivotTopCenter, so it
         fills the container and a strip at y=0 sits on top of row one.
         pivotBottomCenter pins it to the BOTTOM instead, and absoluteSizeOffset is SUBTRACTED
         from the computed size (GuiElement.lua:422) , so 46px of height comes off the TOP and
         no position override is needed. This is the base game's own idiom, copied from
         fs25_subCategorySelectorTabbedContainer.
         IT HAS TO BE A PROFILE. `with` is read at GuiProfile.lua:58 and NOWHERE ELSE: a
         `with=` written on a GUI ELEMENT is silently ignored, which is exactly how the first
         version of this shipped doing nothing (5.87a).
         The 90px of width is fs25_settingsLayout's own value, restated because
         absoluteSizeOffset is replaced wholesale rather than merged. -->
    <Profile name="SDSettingsLayoutTabbed" extends="fs25_settingsLayout" with="pivotBottomCenter">
        <absoluteSizeOffset value="90px 46px" />
    </Profile>
    <Profile name="SDInputsDialogBox" extends="SDAdvDialogBox">
        <size value="1400px 900px" />
    </Profile>
    <!-- THE ROUTING GRAPH's box, and it is the only DR dialog sized as a PERCENTAGE.
         That is deliberate and it is what makes it resolution-aware with no code at all.
         6.15's widening hook multiplies every literal px WIDTH of DR content by the ultrawide
         factor, and it SKIPS a percentage (a percentage resolves from the parent, which has
         already been widened, so scaling it again compounds down the tree). So:
           * in px, a box sized to fill 16:9 would land at ~104% of a 21:9 screen and hang off
             the edge, because the factor there is about 1.46;
           * as a percentage it fills the same fraction of ANY screen, and the CONTENT inside it
             is still px and still widened, capped at LAYOUT_TARGET_WIDTH (84% of screen), which
             a 96% box always contains.
         The three chrome parts (fs25_dialogBgTop / Middle / Bottom) are anchorTopStretchingX /
         anchorStretchingYStretchingX / anchorBottomStretchingX, so the frame follows whatever
         size this is - read from guiProfiles.xml (8.1a), not assumed.
         NOT extended from SDAdvDialogBox: that one is shared with the Advanced Outputs dialog
         and must not grow with this, which is the same reason SDInputsDialogBox and
         SDPickDialogBox each carry their own size. -->
    <Profile name="SDRoutingDialogBox" extends="fs25_dialogBg">
        <size value="1581px 1050px" />
    </Profile>

    <!-- the generic PICK-FROM-A-LIST pop-up. Its OWN size rather than SDInputsDialogBox's,
         for 5.77's reason: that one is shared with a dialog that must not grow with it. -->
    <Profile name="SDPickDialogBox" extends="SDAdvDialogBox">
        <size value="900px 840px" />
    </Profile>
    <!-- dropdown / stepper selector (left/right arrows + text) for the spawn pop-up.
         anchorBottomCenter + positive-Y positions is the base-game dialog convention. -->
    <Profile name="SDMultiTextOption" extends="baseReference" with="anchorBottomCenter">
        <size value="460px 40px" />
        <autoAddDefaultElements value="true" />
        <defaultProfileButtonLeft value="fs25_multiTextOptionLeft" />
        <defaultProfileButtonRight value="fs25_multiTextOptionRight" />
        <defaultProfileText value="fs25_multiTextOptionText" />
        <defaultProfileBgThreePart value="fs25_multiTextOptionBg" />
    </Profile>
    <!-- IN-ROW MODE ARROWS: TEXT-GLYPH STANDBY, currently UNUSED.
         The output tables use the base game's fs25_multiTextOptionLeft / Right directly, untouched,
         so they carry the stock arrow art.

         Keep this as the fallback. The first attempt DID extend those profiles but also overrode their
         size (26px square) and their anchoring, and the arrows rendered as garbled blocks in the rows:
         re-sized, they sample the UI atlas wrongly. The profiles file is packed inside dataS.gar so the
         slice geometry cannot be read to correct it, and the shipped Lua names no left/right arrow slice
         to borrow (only gui.fastforward_arrow). If the stock art turns out not to work standalone at all
         (note SDStep10Button below, the only other standalone use, replaces the image rather than
         inheriting it) switch the three page XMLs back to this profile and give each button
         text="&lt;" / text="&gt;". A glyph has no UVs to get wrong and scales with textSize.

         The image is zeroed in all three states, the same way SDBodyItem above suppresses its
         background, so nothing can draw behind the glyph. ONE profile serves both sides: they differ
         only by the character passed at the use site. -->
    <!-- RIGHT arrow only. The LEFT one is used stock and places correctly from a plain position; the
         right one placed from the same kind of position rendered nowhere at all, which is what a
         right-edge anchor does when it is fed a left-edge coordinate. The stepper's two arrows sit at
         opposite ends of their parent, so they are anchored to opposite edges.

         ONLY the anchoring is overridden, deliberately. Overriding the SIZE is what produced the
         garbled arrows in the first attempt, so that is left alone here; anchoring moves an element
         without changing how its image is sampled. anchorStretchingYLeft is what SDRowCell uses, i.e.
         the anchoring every other cell in these rows is positioned by. -->
    <Profile name="SDRowArrowRight" extends="fs25_multiTextOptionRight" with="anchorStretchingYLeft" />

    <!-- ================= PAGE TAB STRIP, IN THE HEADER =================
         The strip lives in fs25_menuHeaderPanel, in the band the page TITLE used to
         occupy, and the two are alternatives: when a strip is showing the active tab
         already names the page, and when PAGE_TAB_MIN suppresses the strip the title
         comes back. That is what makes this cost ZERO vertical space, where putting it
         above the content would have taken 46px off the bottom list of every tabbed
         page (all of them tile to exactly -810px) and moved every _scrollMap with it.

         anchorMiddleLeft so it sits on the title's own centre line. It has to be on a
         PROFILE: a with= written on an element is read by nothing and silently ignored
         (5.87a).

         WIDTH BUDGET. fs25_menuHeaderPanel is the container less its 56px
         absoluteSizeOffset, about 1494px, and the icon occupies 15..81. Starting at 100
         leaves ~1394. The strip uses 1336 of it:
           prev arrow 0..40 | six 200px tabs from 48, 8px gutters, last ends 1288
           next arrow 1296..1336
         200px at 18px bold uppercase is about 13 characters, so TAB LABELS MUST BE
         SHORT, shorter than the page titles they replace. German runs ~30% longer
         (5.60) and a tab clips rather than wraps. -->
    <Profile name="SDHeaderTabStrip" extends="emptyPanel" with="anchorMiddleLeft">
        <position value="100px 0px" />
        <size value="1336px 50px" />
    </Profile>

    <!-- The A / D hints at each end of the strip. TEXT GLYPHS, not the stock arrow art:
         5.64 records fs25_multiTextOptionLeft/Right rendering as garbled blocks whenever
         they are re-sized, because the icon is sampled from the UI atlas whose slice
         geometry is not readable, and these need a letter beside them, so they would
         have to be sized. A chevron in text cannot garble.
         They are BUTTONS as well as hints: a mouse player can click them, which is free
         once the element exists and is what the keyboard hint would otherwise deny them. -->
    <!-- A page standing in for content that is not built yet. Big, centred, quiet:
         it is a state, not a heading, so it sits in the body rather than the header. -->
    <Profile name="SDPlaceholder" extends="fs25_textDefault">
        <textSize value="30px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textAlignment value="center" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainLight" />
    </Profile>

    <Profile name="SDHeaderTabArrow" extends="emptyPanel">
        <size value="40px 50px" />
        <textBold value="true" />
        <textSize value="20px" />
        <textAlignment value="center" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textFocusedColor value="$preset_fs25_colorMainHighlight" />
        <textSelectedColor value="$preset_fs25_colorMainHighlight" />
    </Profile>

    <Profile name="SDRowArrow" extends="baseReference" with="anchorStretchingYLeft">
        <size value="26px 26px" />
        <textBold value="true" />
        <textSize value="18px" />
        <textAlignment value="center" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textFocusedColor value="$preset_fs25_colorMainHighlight" />
        <textSelectedColor value="$preset_fs25_colorMainHighlight" />
        <imageColor value="0 0 0 0" />
        <imageSelectedColor value="0 0 0 0" />
        <imageFocusedColor value="0 0 0 0" />
    </Profile>
    <!-- +10 / -10 quantity buttons for the spawn pop-up. Uses the base-game button image, but with DR's
         own palette + property set (distinct from any other mod's stepper profile). -->
    <Profile name="SDStep10Button" extends="fs25_multiTextOptionLeft" with="anchorBottomCenter">
        <size value="62px 34px" />
        <imageSliceId value="gui.3dShop_button" />
        <imageFocusedSliceId value="gui.3dShop_button_selected" />
        <imageColor value="$preset_fs25_colorMainLight" />
        <imageFocusedColor value="$preset_fs25_colorMainHighlight" />
        <textSize value="17px" />
        <textColor value="$preset_fs25_colorMainDark" />
        <textFocusedColor value="$preset_fs25_colorMainDark" />
    </Profile>
    <!-- The routing tab's building control: a WIDE TEXT BUTTON that opens the picker list.
         Same shape as SDStep10Button, which is proven in game. A stretchable button
         BACKGROUND is exactly the case 5.70 allows, unlike the atlas sampled arrow ART that
         5.64 records garbling when it is re-sized. The inherited arrow icon is suppressed
         outright so there is none to garble. -->
    <Profile name="SDPickButton" extends="fs25_multiTextOptionLeft">
        <size value="560px 40px" />
        <iconSliceId value="noSlice" />
        <imageSliceId value="gui.3dShop_button" />
        <imageFocusedSliceId value="gui.3dShop_button_selected" />
        <imageColor value="$preset_fs25_colorMainLight" />
        <imageFocusedColor value="$preset_fs25_colorMainHighlight" />
        <textSize value="18px" />
        <textAlignment value="center" />
        <textColor value="$preset_fs25_colorMainDark" />
        <textFocusedColor value="$preset_fs25_colorMainDark" />
    </Profile>

    <!-- THE ROUTING TAB'S CONTROL STRIP. Both shapes are modelled on SDPickButton above, which is
         proven in game: a STRETCHABLE button background (gui.3dShop_button, a ThreePartBitmap) is
         exactly the case 5.70 allows, unlike the atlas sampled arrow ART that 5.64 records garbling
         whenever it is re-sized. The inherited arrow icon is suppressed outright so there is none to
         garble, and the glyph is TEXT, which has no UVs to get wrong and scales with textSize.
         Anchoring is NOT overridden: fs25_multiTextOptionLeft brings anchorStretchingYLeft, which is
         what places a fixed-height button inside a row from a plain y, the way the in-row mode arrows
         are placed. -->
    <Profile name="SDCtlButton" extends="fs25_multiTextOptionLeft" with="anchorTopLeft">
        <size value="140px 44px" />
        <iconSliceId value="noSlice" />
        <iconSize value="0px 0px" />
        <iconTextOffset value="0px 0px" />
        <imageSliceId value="gui.colorPreset" />
        <imageFocusedSliceId value="gui.colorPreset" />
        <imageColor value="0.24 0.26 0.29 0.9" />
        <imageHighlightedColor value="0.34 0.37 0.41 1" />
        <imageFocusedColor value="0.34 0.37 0.41 1" />
        <imageSelectedColor value="0.24 0.26 0.29 0.9" />
        <imageDisabledColor value="0.24 0.26 0.29 0.4" />
        <textSize value="12px" />
        <textAlignment value="center" />
        <textColor value="0.90 0.90 0.90 1" />
        <textFocusedColor value="1 1 1 1" />
        <textHighlightedColor value="1 1 1 1" />
        <textDisabledColor value="0.55 0.57 0.60 1" />
    </Profile>

    <!-- THE TYPED NUMBER FIELD, and its grey prompt. Both are DR's own copies of Husbandry
         Redux's ARNumberInput / ARNumberHint, the shape its auto trader uses: a real selector
         BOX with the stock left and right arrows at its ends and a field between them. COPIED
         rather than borrowed, because check_profiles.py requires each mod's layouts to resolve
         against its own profiles and DR must never depend on AR, see 5.87.

         PERCENTAGE SIZED with an 80px absoluteSizeOffset, so dropped into a box of any width the
         field leaves exactly the two 40px arrows uncovered. absoluteSizeOffset is SUBTRACTED,
         see GuiElement.lua:422, the same mechanism 5.90 uses to shrink the settings list.

         THE PROMPT IS A SEPARATE ELEMENT because TextInputElement has no placeholder at all 
         imePlaceholder reaches the console IME overlay and never the field, and because a
         prompt held in the field's own text becomes real input the moment a character lands on
         it. It cannot steal the click: TextElement declares no mouseEvent of its own and
         GuiElement:mouseEvent only propagates.

         SMALLER AND DIMMER THAN THE VALUE, so a prompt is never mistaken for a number that has
         been chosen. -->
    <!-- THE INTERIOR OF A NUMBER BOX, and it exists because of WHAT IS BEHIND IT.
         fs25_multiTextOptionBg is an OUTLINE: its three slices are
         gui.3dShop_button_outline_left / _middle / _right, read straight out of
         guiProfiles.xml (8.1a). In Husbandry Redux the same control sits on
         fs25_dialogBg, a solid panel, so the outline reads as a field with a dark
         interior. On the routing PAGE there is nothing behind it but the dimmed
         game world, and the identical element reads as a bare rail with a number
         floating on it. Reported 2026-09-22 as "the controls still look completely
         different" with both screens side by side.

         So DR supplies its own interior. PERCENTAGE SIZED, which also keeps it out
         of the 6.15 widening: a percentage resolves from the parent, which has
         already been widened, and scaling it again would compound down the tree.
         Declared FIRST inside the box so it draws behind the outline and behind
         the text. -->
    <!-- THE ROUTING GRAPH's field captions, the line above each typed box. SDBarLabel itself is
         right in every respect except size: it is the storage bar's caption and lives in a 42px
         table row, while these three are the only labelling on a strip nearly a screen wide.
         NOT SDHeaderLeft, which is 16px bold UPPERCASE white-50: that is what this mod's TABLE
         HEADERS use, and three of those in a row read as a header bar rather than as three
         separate controls, which is exactly how this looked beside Husbandry Redux's Auto Trader
         (reported 2026-09-23). -->
    <Profile name="SDFieldLabel" extends="SDBarLabel">
        <textSize value="14px" />
    </Profile>

    <!-- THE FILL-ORDER NUMBER on a routing destination: big, so the order reads at a glance from
         across the column rather than having to be traced through the connectors. Deliberately
         much larger than anything else on the node, because it is the one thing on that node the
         player SETS rather than reads.
         anchorStretchingYLeft like SDRowCell, so its y is an offset from the node's CENTRE
         (5.107) and 0 centres it against the three text lines beside it. -->
    <Profile name="SDRankBadge" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="true" />
        <textSize value="26px" />
        <textAlignment value="center" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainHighlight" />
    </Profile>

    <Profile name="SDNumberInput" extends="fs25_textInput" with="anchorStretchingYStretchingX">
        <size value="100% 100%" />
        <absoluteSizeOffset value="80px 0px" />
        <textSize value="16px" />
        <textAlignment value="center" />
        <textColor value="0.9 0.9 0.9 1" />
        <maxInputTextWidth value="100px" />
    </Profile>

    <Profile name="SDNumberHint" extends="fs25_textDefault" with="anchorStretchingYStretchingX">
        <size value="100% 100%" />
        <absoluteSizeOffset value="80px 0px" />
        <textSize value="14px" />
        <textAlignment value="center" />
        <textColor value="0.5 0.5 0.5 1" />
        <textMaxNumLines value="1" />
    </Profile>
</GUIProfiles>

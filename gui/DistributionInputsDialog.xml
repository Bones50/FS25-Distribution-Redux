<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Distribution Redux: Advanced Inputs window, scoped to ONE receiving building.
     A single list: one row per input product the building can hold. Each row shows the
     product, whether its storage is Pooled or Individual, how much is held, and its max
     (as a % with the live litre equivalent, or BLOCKED). Buttons act on the selected row.

     LAYOUT NOTE: the SDList profile is anchorStretchingYLeft + pivotTopLeft, so list
     elements are positioned from the BOX'S LEFT EDGE with POSITIVE X. Only the centre-
     anchored Text elements (title/subtitle) sit at x=0. Buttons must use profile
     "buttonOK" (capital K); the lowercase spelling renders as a white bar. -->
<GUI name="DistributionInputsDialog" onOpen="onOpen" onClose="onClose">
    <GuiElement type="empty" profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />

    <GuiElement profile="SDAdvDialogBox" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall" />
        <ThreePartBitmap profile="fs25_dialogBgTopSmall" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="fs25_dialogTitle" id="dialogTitleElement" text="$l10n_dr_title_advancedInputs" position="0px -30px" />
            <Text profile="fs25_dialogText"  id="dialogTextElement"  text=""                position="0px -78px" />

            <!-- single list: input products -->
            <Bitmap profile="SDList" position="40px -122px" size="1120px 34px">
                <Text profile="SDHeaderLeft" position="12px 0px"  size="240px 34px"  text="$l10n_dr_col_incomingProduct" />
                <Text profile="SDHeaderLeft" position="296px 0px" size="90px 34px"   text="$l10n_dr_col_type" />
                <Text profile="SDHeaderLeft" position="392px 0px" size="150px 34px"  text="$l10n_dr_col_held" />
                <Text profile="SDHeaderLeft" position="548px 0px" size="195px 34px"  text="$l10n_dr_col_maxIn" />
                <Text profile="SDHeaderLeft" position="749px 0px" size="150px 34px"  text="$l10n_dr_col_available" />
                <Text profile="SDHeaderLeft" position="905px 0px" size="215px 34px"  text="$l10n_dr_col_fillTarget" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
            </Bitmap>
            <GuiElement profile="SDList" position="40px -160px" size="1120px 480px">
                <SmoothList profile="SDList" id="inputList" position="0px 0px" size="1120px 480px"
                            onSelectionChanged="onListSelectionChanged">
                    <ListItem profile="SDListItem" name="rowTemplate" size="1120px 46px" onClick="onClickInputRow">
                        <Bitmap position="12px 11px" size="24px 24px" name="fillIcon" imageColor="1 1 1 1" />
                        <Text profile="SDRowCell" position="48px 0px"  size="230px 46px" textSize="17px" name="name" />
                        <Text profile="SDRowCell" position="296px 0px" size="90px 46px"  textSize="16px" name="kind" />
                        <Text profile="SDRowCell" position="392px 0px" size="150px 46px" textSize="16px" name="held" />
                        <Text profile="SDRowCell" position="548px 0px" size="195px 46px" textSize="16px" name="cap" />
                        <Text profile="SDRowCell" position="749px 0px" size="150px 46px" textSize="16px" name="avail" />
                        <Text profile="SDRowCell" position="905px 0px" size="215px 46px" textSize="16px" name="target" />
                    </ListItem>
                </SmoothList>
            </GuiElement>
        </GuiElement>

        <!-- action buttons -->
        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="buttonOK"   text="$l10n_dr_btn_maxDown"   onClick="onCapDown"     id="capDownButton" inputActionName="MENU_EXTRA_1" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonOK"   text="$l10n_dr_btn_maxUp"   onClick="onCapUp"       id="capUpButton"   inputActionName="MENU_EXTRA_2" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonOK"   text="$l10n_dr_btn_targetDown" onClick="onTargetDown" id="targetDownButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonOK"   text="$l10n_dr_btn_targetUp" onClick="onTargetUp"   id="targetUpButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonOK"   text="$l10n_dr_btn_block"   onClick="onToggleBlock" id="blockButton"   inputActionName="MENU_ACCEPT" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonOK"   text="$l10n_dr_btn_blockAll" onClick="onToggleAllBlock" id="blockAllButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonBack" text="$l10n_dr_btn_close"   onClick="onClickBack"   id="noButton" />
        </BoxLayout>
    </GuiElement>
</GUI>
